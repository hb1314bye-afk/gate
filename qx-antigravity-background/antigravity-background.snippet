# Antigravity Remote Control wallpaper v1 (independent from ChatGPT)
hostname = antigravity.static.usercontent.goog
^https:\/\/antigravity\.static\.usercontent\.goog\/web\/[^/?]+\/compiled_tailwind\.css(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/hb1314bye-afk/gate/main/qx-antigravity-background/antigravity-background-v1.js
^https:\/\/antigravity\.static\.usercontent\.goog\/web\/[^/?]+\/(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/hb1314bye-afk/gate/main/qx-antigravity-background/antigravity-background-v1.js
