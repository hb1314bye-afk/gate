# ChatGPT mobile wallpaper
# Disable any older local wallpaper rule before enabling this resource.
hostname = chatgpt.com
^https:\/\/chatgpt\.com\/(?:\?.*|(?:c|g|share)\/[^?]*(?:\?.*)?)?$ url script-response-body https://raw.githubusercontent.com/hb1314bye-afk/gate/main/qx-chatgpt-background/chatgpt-background.js
