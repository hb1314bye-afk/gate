波点音频响应诊断 = type=http-response,pattern=^https?://bd-api\.kuwo\.cn/api/play/music/v2/audioUrl(?:\?|$),requires-body=0,engine=jsc,timeout=10,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/shadowrocket-modules/diagnostics/bodian-audiourl-test.js

