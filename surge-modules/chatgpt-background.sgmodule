#!name=ChatGPT 双图背景 V15 · Surge
#!desc=沿用反重力/Claude 的双图原图，适配 ChatGPT 新旧移动网页和主屏幕 WebApp。单层背景保持原比例，已发送消息去气泡，菜单保留原生底色；内嵌图片，仅处理 HTML/CSS 响应。请停用旧版 ChatGPT 背景模块后启用。
#!system=ios
#!date=2026-11-04

[Script]
ChatGPT V15 背景 CSS = type=http-response,pattern=^https:\/\/chatgpt\.com\/(?:cdn\/assets|unauth-mweb\/assets|_next\/static\/css)\/[^?#]+\.css(?:\?[^#]*)?$,requires-body=true,max-size=4194304,timeout=10,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/chatgpt/chatgpt-background-v15.js?v=15-20261104,script-update-interval=3600
ChatGPT V15 背景 HTML = type=http-response,pattern=^https:\/\/chatgpt\.com\/(?:c\/[^?#]+|g\/[^?#]+|share\/[^/?#]+|(?:images|library|projects|settings)(?:\/[^?#]*)?)?(?:\?[^#]*)?$,requires-body=true,max-size=4194304,timeout=10,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/chatgpt/chatgpt-background-v15.js?v=15-20261104,script-update-interval=3600

[MITM]
hostname = %APPEND% chatgpt.com
