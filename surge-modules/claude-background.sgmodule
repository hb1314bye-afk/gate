#!name=Claude WebApp 原图背景 · Surge
#!desc=提亮版 V3：Claude 移动网页/PWA 竖屏背景。内嵌原图避免外链受限，支持聊天、首页与登录等 HTML 页面及常用样式 CDN；仅改写 HTML/CSS，不接触聊天 API。
#!system=ios

[Script]
Claude 背景 HTML = type=http-response,pattern=^https:\/\/claude\.ai\/(?:\?[^#]*|(?:new|chat|login|projects?|recents?|settings|onboarding|artifacts|upgrade|organization)(?:[/?][^#]*)?)?$,requires-body=true,max-size=4194304,timeout=30,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/claude/claude-background.js?v=3,script-update-interval=3600
Claude 背景 CSS = type=http-response,pattern=^https:\/\/(?:claude\.ai|assets\.claude\.ai|assets-proxy\.anthropic\.com|a-cdn\.claude\.ai)\/[^?#]*\.css(?:\?[^#]*)?$,requires-body=true,max-size=4194304,timeout=30,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/claude/claude-background.js?v=3,script-update-interval=3600

[MITM]
hostname = %APPEND% claude.ai, assets.claude.ai, assets-proxy.anthropic.com, a-cdn.claude.ai
