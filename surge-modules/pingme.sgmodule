#!name=PingMe 自动签到与视频奖励 · Surge
#!desc=适配 QX PingMe 多账号签到脚本，抓取账号参数并在每天 08:30 / 20:30 执行。通过 GitHub Actions 同步原作者脚本。不包含个人账号信息。
#!system=ios

[Script]
PingMe 账号参数捕获 = type=http-request,pattern=^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus(?:\?|$),requires-body=false,timeout=20,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/pingme/pingme-surge.js,script-update-interval=3600
PingMe 定时签到 = type=cron,cronexp="30 8,20 * * *",wake-system=true,timeout=600,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/pingme/pingme-surge.js,script-update-interval=3600

[MITM]
hostname = %APPEND% api.pingmeapp.net
