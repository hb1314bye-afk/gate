[Script]
节点极速测速 V6.1 Apple = type=generic,engine=webview,timeout=180,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/speedtest/surge-speedtest-ultra-v6.js?v=6.1,script-update-interval=3600,argument=direction=both&mode=concurrent&adaptive=true&concurrency=16&duration=15&warmup=2&maxMB=unlimited&chunkKB=16000&uploadChunkKB=4000&requestTimeout=15&notify=false&test_source=apple&upload_source=apple
节点极速测速 V6.1 CF下载 = type=generic,engine=webview,timeout=120,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/speedtest/surge-speedtest-ultra-v6.js?v=6.1,script-update-interval=3600,argument=direction=download&mode=concurrent&adaptive=true&concurrency=16&duration=15&warmup=2&maxMB=unlimited&chunkKB=16000&uploadChunkKB=4000&requestTimeout=15&notify=false&test_source=Cloudflare

[Panel]
节点极速测速 V6.1 Apple = title="节点极速测速 V6.1 · Apple",content="16路并发 · 单次最多16MB · 不限总流量\n下载上传各15秒；点击刷新运行",style=info,script-name=节点极速测速 V6.1 Apple
