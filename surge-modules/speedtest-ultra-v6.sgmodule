#!name=Surge 节点极速测速 V6 · 16路实验版
#!desc=16路并发，单请求最大16MB，总流量不限；高流量及内存占用风险。手动刷新才运行。与V5独立。
#!system=ios

[Script]
极速测速 V6 Apple = type=generic,engine=webview,timeout=180,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/speedtest/surge-speedtest-ultra-v6.js?v=6,argument=direction=both&mode=concurrent&adaptive=true&concurrency=16&duration=15&warmup=2&maxMB=unlimited&chunkKB=16000&uploadChunkKB=4000&requestTimeout=15&notify=false&test_source=apple&upload_source=apple
极速测速 V6 CF = type=generic,engine=webview,timeout=120,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/speedtest/surge-speedtest-ultra-v6.js?v=6,argument=direction=download&mode=concurrent&adaptive=true&concurrency=16&duration=15&warmup=2&maxMB=unlimited&chunkKB=16000&requestTimeout=15&notify=false&test_source=Cloudflare

[Panel]
极速测速 V6 Apple = title="极速测速 V6 · Apple",content="16路并发 · 16MB单请求 · 不限总流量\n点击刷新测试",style=info,script-name=极速测速 V6 Apple
极速测速 V6 CF = title="极速测速 V6 · Cloudflare",content="16路并发 · 16MB单请求 · 不限总流量\n点击刷新测试",style=info,script-name=极速测速 V6 CF
