#!name=YouTube 谷歌翻译简体中文字幕 · Surge
#!desc=v2：优先尝试 YouTube 原生中文字幕翻译，失败后使用 Google 免费接口；保留超时前已完成的译文，减少并发与限流等待。仅处理已有字幕，不生成无字幕视频的字幕；失败保留原文。
#!system=ios

[Script]
YouTube Google 简中字幕 = type=http-response,pattern=^https:\/\/(?:www|m|music)\.youtube\.com\/api\/timedtext\?,requires-body=true,max-size=1048576,timeout=25,engine=webview,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/youtube-zh-google/google-captions-surge.js?v=2,script-update-interval=3600

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, music.youtube.com

