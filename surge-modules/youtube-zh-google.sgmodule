#!name=YouTube 谷歌翻译简体中文字幕 · Surge
#!desc=将 YouTube 已有韩/英/日等字幕尝试翻译为简体中文（Google 非官方免费接口）。无需密钥；失败保留原文，不生成原视频没有的字幕。仅拦截字幕响应，不修改视频、登录或账户 API。
#!system=ios

[Script]
YouTube Google 简中字幕 = type=http-response,pattern=^https:\/\/www\.youtube\.com\/api\/timedtext\?,requires-body=true,max-size=1048576,timeout=20,script-path=https://raw.githubusercontent.com/hb1314bye-afk/gate/main/surge-modules/youtube-zh-google/google-captions-surge.js?v=1,script-update-interval=3600

[MITM]
hostname = %APPEND% www.youtube.com
